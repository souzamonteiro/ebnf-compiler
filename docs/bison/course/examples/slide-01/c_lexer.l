%{
/*** Definition Section ***/

#include "c_parser.tab.h" // Include the token definitions generated by Bison
#include <stdlib.h>       // For strdup() and atoi()

// Prototype to fix potential compiler warning
void yyerror(const char *s);
%}

%%

 /*** Rules Section ***/

/* Keywords */
"int"       { return INT; }
"return"    { return RETURN; }
"if"        { return IF; }
"while"     { return WHILE; }

/* Operators and Punctuation */
"+"         { return PLUS; }
"-"         { return MINUS; }
"="         { return ASSIGN; }
"=="        { return EQ; }
"<"         { return LT; }
"("         { return LPAREN; }
")"         { return RPAREN; }
"{"         { return LBRACE; }
"}"         { return RBRACE; }
";"         { return SEMICOLON; }

/* Identifiers (variable names, function names) */
[a-zA-Z_][a-zA-Z0-9_]*  { yylval.str = strdup(yytext); return IDENTIFIER; }

/* Integer numbers */
[0-9]+      { yylval.num = atoi(yytext); return NUMBER; }

/* Skip whitespace */
[ \t\n]     { /* ignore whitespace */ }

/* Catch any other unexpected character and report an error */
.           { yyerror("Invalid character"); return ERROR; }

%%

/*** C Code Section ***/
int yywrap(void) {
    return 1; // Indicate end of input to the parser
}