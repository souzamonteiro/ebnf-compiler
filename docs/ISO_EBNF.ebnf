syntax         = { rule | directive | comment | space } ;

rule           = identifier, "=", expression, ";" ;

expression     = term, { "|", term } ;
term           = factor, { factor } ;
factor         = primary, [ repetition ] ;

repetition     = "*" 
               | "+" 
               | "?" 
               | "{", integer, [ ",", [ integer ] ], "}" ;

primary        = identifier
               | terminal
               | optional
               | repeated
               | group
               | special_sequence
               | char_range ;

optional       = "[", expression, "]" ;
repeated       = "{", expression, "}" ;
group          = "(", expression, ")" ;

special_sequence = "?", { character - "?" }, "?" ;

directive      = "%", identifier, [ "(", literal, ")" ], "%" ;

%TOKENS%

literal        = string | identifier | integer | hex_char ;

terminal       = string | hex_char ;

string         = '"', { string_char }, '"' 
               | "'", { string_char }, "'" ;

string_char    = escape_sequence 
               | character - ('"' | "'" | "\\" ) ;

escape_sequence = "\\", (
                   '"'  | "'"  | "\\" | "n" | "r" | "t"
                 | "u", hex_digit, hex_digit, hex_digit, hex_digit
                 ) ;

char_range     = hex_char, "..", hex_char ;

identifier     = letter, { letter | digit | "_" } ;

integer        = digit, { digit } ;

hex_char       = "#", hex_digit, hex_digit, hex_digit, hex_digit ;

comment        = block_comment | line_comment ;
block_comment  = "(*", { character - "*" | "*", character - ")" }, "*)" ;
line_comment   = "//", { character - ("\n" | "\r") }, ( "\n" | "\r" ) ;

character      = unicode ;

unicode        = "#0000" .. "#FFFF" ;

letter         = "A".."Z" | "a".."z" ;
digit          = "0".."9" ;
hex_digit      = digit | "A".."F" | "a".."f" ;

space          = " " | "\t" | "\n" | "\r" ;