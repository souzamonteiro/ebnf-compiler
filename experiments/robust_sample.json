{
  "Grammar": [{
      "Rule": {
        "name": "program",
        "expr": {
          "Sequence": [{
            "Terminal": "PROGRAM"
          }, {
            "Identifier": "identifier"
          }, {
            "Terminal": ";"
          }, {
            "Identifier": "block"
          }, {
            "Terminal": "."
          }]
        }
      }
    },
    {
      "Rule": {
        "name": "block",
        "expr": {
          "Sequence": [{
            "Repetition": {
              "Identifier": "declaration"
            }
          }, {
            "Terminal": "BEGIN"
          }, {
            "Repetition": {
              "Sequence": [{
                "Identifier": "statement"
              }, {
                "Terminal": ";"
              }]
            }
          }, {
            "Terminal": "END"
          }]
        }
      }
    },
    {
      "Rule": {
        "name": "declaration",
        "expr": {
          "Sequence": [{
            "Terminal": "VAR"
          }, {
            "Identifier": "identifier"
          }, {
            "Terminal": ":"
          }, {
            "Identifier": "type"
          }, {
            "Terminal": ";"
          }]
        }
      }
    },
    {
      "Rule": {
        "name": "type",
        "expr": {
          "Choice": [{
            "Terminal": "INTEGER"
          }, {
            "Terminal": "BOOLEAN"
          }]
        }
      }
    },
    {
      "Rule": {
        "name": "statement",
        "expr": {
          "Choice": [{
            "Identifier": "assignment"
          }, {
            "Identifier": "if_statement"
          }, {
            "Identifier": "while_statement"
          }, {
            "Identifier": "block"
          }]
        }
      }
    },
    {
      "Rule": {
        "name": "assignment",
        "expr": {
          "Sequence": [{
            "Identifier": "identifier"
          }, {
            "Terminal": ":="
          }, {
            "Identifier": "expression"
          }]
        }
      }
    },
    {
      "Rule": {
        "name": "if_statement",
        "expr": {
          "Sequence": [{
            "Terminal": "IF"
          }, {
            "Identifier": "expression"
          }, {
            "Terminal": "THEN"
          }, {
            "Identifier": "statement"
          }, {
            "Optional": {
              "Sequence": [{
                "Terminal": "ELSE"
              }, {
                "Identifier": "statement"
              }]
            }
          }]
        }
      }
    },
    {
      "Rule": {
        "name": "while_statement",
        "expr": {
          "Sequence": [{
            "Terminal": "WHILE"
          }, {
            "Identifier": "expression"
          }, {
            "Terminal": "DO"
          }, {
            "Identifier": "statement"
          }]
        }
      }
    },
    {
      "Rule": {
        "name": "expression",
        "expr": {
          "Sequence": [{
            "Identifier": "term"
          }, {
            "Repetition": {
              "Sequence": [{
                "Group": {
                  "Choice": [{
                    "Terminal": "+"
                  }, {
                    "Terminal": "-"
                  }]
                }
              }, {
                "Identifier": "term"
              }]
            }
          }]
        }
      }
    },
    {
      "Rule": {
        "name": "term",
        "expr": {
          "Sequence": [{
            "Identifier": "factor"
          }, {
            "Repetition": {
              "Sequence": [{
                "Group": {
                  "Choice": [{
                    "Terminal": "*"
                  }, {
                    "Terminal": "/"
                  }]
                }
              }, {
                "Identifier": "factor"
              }]
            }
          }]
        }
      }
    },
    {
      "Rule": {
        "name": "factor",
        "expr": {
          "Choice": [{
            "Identifier": "identifier"
          }, {
            "Identifier": "number"
          }, {
            "Terminal": "TRUE"
          }, {
            "Terminal": "FALSE"
          }, {
            "Sequence": [{
              "Terminal": "("
            }, {
              "Identifier": "expression"
            }, {
              "Terminal": ")"
            }]
          }]
        }
      }
    },
    {
      "Rule": {
        "name": "identifier",
        "expr": {
          "Sequence": [{
            "Identifier": "letter"
          }, {
            "Repetition": {
              "Choice": [{
                "Identifier": "letter"
              }, {
                "Identifier": "digit"
              }, {
                "Terminal": "_"
              }]
            }
          }]
        }
      }
    },
    {
      "Rule": {
        "name": "number",
        "expr": {
          "Sequence": [{
            "Identifier": "digit"
          }, {
            "Repetition": {
