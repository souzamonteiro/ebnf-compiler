%GRAMMAR%
syntax = { (rule | comment | directive | space) } ;

rule = identifier, (space), "=", (space), expression, (space), ";" ;
expression = term, { (space), "|", (space), term } ;
term = factor, { (space), ",", (space), factor } ;
factor = [ integer, "*" | quantifier ], primary ;
quantifier = "*" | "+" | "?" | "{", integer, [ ",", [ integer ] ], "}" ;

primary = identifier
        | terminal
        | optional
        | repeat
        | group
        | special_sequence
        | char_range
        | hex_char ;

optional = "[", (space), expression, (space), "]" ;
repeat = "{", (space), expression, (space), "}" ;
group = "(", (space), expression, (space), ")" ;
special_sequence = "?", { character - "?" }, "?" ;

%TOKENS%
identifier = (letter | "_"), { letter | digit | "_" } ;

terminal = '"', { string_char }, '"' | "'", { string_char }, "'" ;
string_char = character - ('"' | "'" | "\") 
            | escape_sequence
            | unicode_escape ;
escape_sequence = "\", ( "\" | "'" | '"' | "n" | "t" | "r" | "b" | "f" ) ;
unicode_escape = "\u", hex_digit, hex_digit, hex_digit, hex_digit ;

comment = block_comment | line_comment ;
block_comment = "(*", { comment_char | block_comment }, "*)" ;
line_comment = "//", { character - (#0A | #0D) }, ( #0A | #0D ) ;
comment_char = character - "*" | "*", character - ")" ;

%DIRECTIVES%
directive = "%", identifier, [ "(", literal, ")" ], "%" ;

%CHARACTERS%
character = ascii | unicode ;
ascii = #00 .. #7F ;
unicode = #80 .. #10FFFF ;

integer = digit, { digit } ;
letter = "A".."Z" | "a".."z" ;
digit = "0".."9" ;
hex_char = "#", hex_digit, hex_digit ;
char_range = hex_char, (space), "..", (space), hex_char ;
hex_digit = "0".."9" | "A".."F" | "a".."f" ;

space = #20 | #09 | #0A | #0D ;