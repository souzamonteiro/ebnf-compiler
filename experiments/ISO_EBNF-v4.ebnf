%GRAMMAR%
syntax = { (rule | comment | directive | space) } ;

rule = identifier, spaces, "=", spaces, expression, spaces, ";" ;
expression = term, { spaces, "|", spaces, term } ;
term = factor, { spaces, ",", spaces, factor } ;
factor = [ integer, "*" | quantifier ], primary ;
quantifier = "*" | "+" | "?" | "{", spaces, integer, [ ",", spaces, [ integer ] ], spaces, "}" ;

primary = identifier
        | terminal
        | optional
        | repeat
        | group
        | special_sequence
        | char_range
        | hex_char ;

optional = "[", spaces, expression, spaces, "]" ;
repeat = "{", spaces, expression, spaces, "}" ;
group = "(", spaces, expression, spaces, ")" ;
special_sequence = "?", { character - "?" }, "?" ;

%TOKENS%
(* Tokens literais explícitos - CRUCIAIS para self-hosting *)
equals = "=" ;
semicolon = ";" ;
pipe = "|" ;
comma = "," ;
asterisk = "*" ;
plus = "+" ;
question = "?" ;
l_bracket = "[" ;
r_bracket = "]" ;
l_brace = "{" ;
r_brace = "}" ;
l_paren = "(" ;
r_paren = ")" ;
percent = "%" ;

identifier = (letter | "_"), { letter | digit | "_" } ;

terminal = '"', { string_char }, '"' | "'", { string_char }, "'" ;
string_char = character - ('"' | "'" | "\") 
            | escape_sequence
            | unicode_escape ;
escape_sequence = "\", ( "\" | "'" | '"' | "n" | "t" | "r" | "b" | "f" ) ;
unicode_escape = "\u", hex_digit, hex_digit, hex_digit, hex_digit ;

comment = block_comment | line_comment ;
block_comment = "(*", { comment_char | block_comment }, "*)" ;
line_comment = "//", { character - (#0A | #0D) }, ( #0A | #0D ) ;
comment_char = character - "*" | "*", character - ")" ;

%DIRECTIVES%
directive = percent, identifier, [ "(", literal, ")" ], percent ;

%CHARACTERS%
character = ascii | unicode ;
ascii = #00 .. #7F ;
unicode = #80 .. #10FFFF ;

integer = digit, { digit } ;
letter = "A".."Z" | "a".."z" ;
digit = "0".."9" ;
hex_char = "#", hex_digit, hex_digit ;
char_range = hex_char, spaces, "..", spaces, hex_char ;
hex_digit = "0".."9" | "A".."F" | "a".."f" ;

spaces = space, { space } ;
space = #20 | #09 | #0A | #0D ;